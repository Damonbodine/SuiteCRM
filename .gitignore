## First part from https://github.com/github/gitignore/blob/master/SugarCRM.gitignore
# Ignore custom .htaccess stuff.
/.htaccess
# Ignore large parts of the annoying cache directory without breaking things.
cache/*
upload/*
!upload/index.html
# Ignore some files and directories from the custom directory.
custom/
custom/history/*
custom/blowfish/*
custom/modulebuilder/*
custom/working/*
custom/modules/*/Ext/
custom/modules/unified_search_modules_display.php
# Ignore AOD indexes
modules/AOD_Index/Index/*
install/status.json
# Ignore PDF Fonts
modules/AOS_PDF_Templates/PDF_Lib/ttfontdata/
# Configuration files should be ignored.
/config.php
/config_override.php
/config_si.php
tests/config.test.php
# Connector configuration should also be ignored.
custom/modules/Connectors/connectors/sources/ext/*/*/config.php
# Logs files can safely be ignored.
*.log
## IDE specific items
# Eclipse
*.pydevproject
.project
.metadata
bin/**
tmp/**
tmp/**/*
*.tmp
*.bak
*.swp
*~.nib
local.properties
.classpath
.settings/
.loadpath
# Emacs
*~
\#*\#
/.emacs.desktop
/.emacs.desktop.lock
.elc
auto-save-list
tramp
# IntelliJ Idea
*.iml
*.ipr
*.iws
.idea/
.phpstorm.meta.php
# NetBeans
nbproject/
# Vim
.*.sw[a-z]
*.un~
Session.vim
tags
# Windows
Thumbs.db
Desktop.ini
.DS_Store
.DS_Store?
# Microsoft Visual Studio
*.sln
*.suo
*.phpproj
# Microsoft Visual Studio Code
.vscode
# Disytel
lang_cmp.php
.kdev4/
SuiteCRM.kdev4

#Ignore composer vendor folder
vendor/
public/

.php_cs.cache


#Ignore bower_components
bower_components/
node_modules/


#Ignore Sass Generated files in SuiteP
themes/SuiteP/css/*.map
themes/SuiteP/css/*/*.map
themes/SuiteP/css/*/color-palette.css
themes/SuiteP/css/*/variables.css
tests/_output/*


#Ignore browserstack
BrowserStackLocal
browserstack.err
cache/
custom/**/
.sass-cache/

# Ignore testing environment
build/tmp/

# IMAP testing
fakeImapResource
include/Imap/ImapTestSettings.txt

# Ignore php-cs-fixer cache
.php_cs.cache

# Ignore custom codeception environments so they won't be committed.
tests/_envs/custom.yml
codeception.yml

# Ignore dotenv files so they don't get commited to git.
# Only .env.dist should be committed.
.env
.env.test
.env.dev

# Logs
logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
dev-debug.log
# Dependency directories
# Environment variables
# Editor directories and files
.idea
*.ntvs*
*.njsproj
*.sw?
# OS specific

# Task files
# tasks.json
# tasks/ 

# Security: Ignore all debug and test files that may contain sensitive data
debug_*.php
test_*.php
check_*.php
cleanup_*.php
populate_*.php
refresh_*.php
send_email.php
compose_email.php
simple_populate_sender.php
clear_template_cache.php
minimal_oauth_test.php
seed_criminal_defense_data.php

# Security: Ignore test HTML files
test_*.html

# Security: Ignore any OAuth callback or completion files that might contain tokens
oauth_*.php
oauth2callback.php
verify_oauth_fix.php

# Security: Ignore any configuration files that might contain API keys or credentials
*_config.php
ai_secure_config.php
secure_config.php

# Security: Ignore environment and credential files
.env*
credentials.json
secrets.json
api_keys.txt

# Security: Ignore any backup or temporary files that might contain sensitive data
*.bak
*.backup
*.tmp
*~

# Security: Ignore log files that might contain sensitive information
*.log
logs/
debug.log
error.log
